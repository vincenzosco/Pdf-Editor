# Folio reverse proxy.
#
# SITE_ADDRESS comes from the compose environment:
#   DOMAIN=example.com  -> Caddy requests a Let's Encrypt certificate for it and
#                          serves it on 443, redirecting 80 to 443.
#   DOMAIN unset        -> ":80", plain HTTP (no certificate is possible for a
#                          bare IP address, but the stack is usable immediately)
# deploy.sh fills DOMAIN with <public-ip>.nip.io unless --no-tls is given, so an
# unattended deploy gets HTTPS without a DNS record of its own.
# APP_UPSTREAM defaults to the app container on its internal port (80).
{$SITE_ADDRESS} {
	encode zstd gzip

	# Uploads can be large, so no request-body or timeout surprises.
	request_body {
		max_size 64MB
	}

	reverse_proxy {$APP_UPSTREAM} {
		transport http {
			read_timeout 15m
			write_timeout 15m
		}
	}

	log {
		output stdout
		format console
	}
}
