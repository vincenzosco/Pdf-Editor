# Copy to .env (deploy.sh writes it for you) and adjust.

# Public port of the app container itself.
PORT=8080

# Public host name. Leave empty to serve plain HTTP on port 80 (an IP address
# cannot get a certificate); set it once a DNS record points at the VM and
# re-run the deploy to get HTTPS automatically.
DOMAIN=

# Image tag, so old builds stay identifiable: `docker images | grep folio`.
FOLIO_TAG=local

# Where Caddy forwards to. Only change it if the app runs outside this stack.
APP_UPSTREAM=app:8080

# Swap file created by remote-setup.sh. The default e2-micro has 1 GB of RAM
# and no swap, which is not enough for LibreOffice or a 300 DPI OCR page.
SWAP_MB=2048
