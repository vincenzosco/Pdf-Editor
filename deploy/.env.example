# Copy to .env (deploy.sh writes it for you) and adjust.

# Port the app container listens on. 80 is the default; the VM's public 80/443
# belong to Caddy, which publishes this one on host 8080 for direct access.
PORT=80

# Public host name Caddy gets a Let's Encrypt certificate for. deploy.sh fills
# in <public-ip>.nip.io when you do not pass --domain, so HTTPS works with no DNS
# of your own; set your own name here once you own one. Leave it empty only if
# you pass --no-tls and want plain HTTP on port 80.
DOMAIN=

# Image tag, so old builds stay identifiable: `docker images | grep folio`.
FOLIO_TAG=local

# Where Caddy forwards to. Only change it if the app runs outside this stack.
APP_UPSTREAM=app:80

# Swap file created by remote-setup.sh. The default e2-micro has 1 GB of RAM
# and no swap, which is not enough for LibreOffice or a 300 DPI OCR page.
SWAP_MB=2048
